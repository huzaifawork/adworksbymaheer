# Copy to .env.local for `npm run dev`; set the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# From https://resend.com/api-keys (Sending access is enough)
RESEND_API_KEY=

# Inbox(es) that receive leads; comma-separate several
CONTACT_TO_EMAIL=adworksbymaheer@gmail.com

# Must be on the domain verified in Resend
CONTACT_FROM_EMAIL=Adworks by Maheer <contact@adworksbymaheer.com>
